# Copy to .env.staging / .env.production and fill in. NEVER commit a filled copy.
# Layer 08: every secret comes from the environment; the repo holds only this template.

APP_ENV=staging                 # development | staging | production
APP_DEBUG=0
APP_VERSION=1.0.0
APP_BASE_URL=https://asaphysio.example
PORT=8080
WORKERS=2

# openssl rand -base64 48
SECRET_KEY=

SESSION_TTL_HOURS=12
ALLOWED_ORIGINS=
TRUST_PROXY=1
MAX_BODY_BYTES=16384

# Optional first-boot owner. Set both to create this owner at startup when the
# database is empty; ignored otherwise. Meant for a diskless preview deploy that is
# wiped on every restart and has no shell for `python -m ops.seed`. Leave blank on
# any instance holding real patient records.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

DB_PATH=data/asa.db
BACKUP_DIR=data/backups
BACKUP_KEEP=14
STATIC_DIR=public

# --- booking delivery (layer: the success message must be true) -------------
# file is DEV ONLY and is rejected when APP_ENV=production
NOTIFY_PROVIDER=telegram        # file | webhook | telegram
NOTIFY_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- layer 09: rate limits ---------------------------------------------------
RL_IP_PER_MIN=60
RL_BOOKING_IP_PER_HOUR=5
RL_BOOKING_PHONE_PER_DAY=3
RL_LOGIN_IP_PER_15MIN=8
RL_AI_USER_PER_HOUR=10
RL_AI_GLOBAL_PER_DAY=200
BREAKER_ERR_THRESHOLD=25
BREAKER_WINDOW_S=60
BREAKER_OPEN_S=30

# --- layer 06: cost ----------------------------------------------------------
AI_ENABLED=0
AI_API_KEY=
AI_UNIT_COST_USD=0.0012
BUDGET_MONTHLY_USD=5
BUDGET_ALERT_AT=0.8

# --- layer 12: alerting ------------------------------------------------------
ALERT_WEBHOOK=
ALERT_FILE=data/alerts.log

# --- layer 10: caching -------------------------------------------------------
STATIC_IMMUTABLE_MAX_AGE=31536000
HTML_MAX_AGE=0
API_CACHE_TTL_S=30

# --- patient portal / SMS ----------------------------------------------------
SMS_PROVIDER=kavenegar          # file | webhook | kavenegar | smsir
                                # 'file' is DEV ONLY and is rejected in production
SMS_API_KEY=
SMS_SENDER=
SMS_WEBHOOK=
SMS_INBOUND_SECRET=             # shared secret the gateway sends as X-SMS-Secret
SMS_UNIT_COST_USD=0.0045
SMS_BUDGET_MONTHLY_USD=3
SMS_FILE=data/sms-outbox.txt

UPLOAD_DIR=data/uploads
MAX_UPLOAD_BYTES=5242880
PATIENT_SESSION_TTL_HOURS=6
REMINDER_LEAD_MIN=120           # confirmation SMS this many minutes before the slot
REMINDER_TICK_S=60
RL_REGISTER_IP_PER_DAY=25
RL_PATIENT_LOGIN_IP_PER_15MIN=10
RL_APPT_PATIENT_PER_DAY=4
